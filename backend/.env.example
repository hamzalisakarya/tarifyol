# Copy values into your local shell or an untracked .env file. Never use these examples in production.
TARIFYOL_DB_PASSWORD=replace-with-a-long-random-password
TARIFYOL_ADMIN_USERNAME=admin
TARIFYOL_ADMIN_PASSWORD=replace-with-a-long-random-password
TARIFYOL_CORS_ALLOWED_ORIGINS=https://tarifyol.de
# Base64 for exactly 32 random bytes. Generate a unique key and keep it outside the database.
TARIFYOL_FIELD_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
